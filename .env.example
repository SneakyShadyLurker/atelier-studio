# Atelier environment template
# Local development: copy to api/.env, then choose an absolute writable DATA_DIR.
# For a complete local trial, follow docs/getting-started.md.
# Production uses infra/docker/.env.production.example instead.
# Never commit a populated .env.

# === Required (atelier-api fails to boot if missing or malformed) ===
# DATA_DIR is the only required value; it is set further down.

# === Optional integrations ===

# CLIProxyAPI, used only for the GPT Image models. Set both or neither.
# Text models are not configured here: connect them in the app's Text models
# view (docs/connect-a-text-model.md).
# CLIPROXY_BASE_URL=http://127.0.0.1:8317
# CLIPROXY_TOKEN=your-cliproxy-token
# Required for GPT Image requests and for text models with "Screen requests
# first" turned on. Without it those requests are refused; nothing else is affected.
# OPENROUTER_API_KEY=your-openrouter-key

# Signed-in usernames (comma-separated) who may manage text providers, models
# and routing in the Text models view. Empty means nobody.
TEXT_PROVIDER_ADMINS=

# Optional local-model worker. Leave empty unless provisioned; plain ComfyUI
# without the included Atelier worker is unsupported (infra/comfyui/README.md).
COMFYUI_BASE_URL=
# COMFYUI_ATELIER_TOKEN=your-worker-token
# COMFYUI_ATELIER_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Optional directory of local model manifests; must be a readable directory
# when set. Unset by default.
# COMFYUI_MODELS_DIR=/srv/atelier/models
# Comma-separated local model ids to enable. Default empty (none).
# COMFYUI_ENABLE_MODELS=

# Absolute writable directory for SQLite, encrypted media and the dev identity.
# Change this path for your machine before starting local development.
DATA_DIR=/srv/atelier

# BYOK encryption: required for storing Google keys and text-provider API keys
# locally, and always required in production.
# Generate with: openssl rand -hex 32
BYOK_ENCRYPTION_KEY=

# === Optional (documented defaults — uncomment to override) ===

# Bind addr / port for atelier-api (behind SWAG; not exposed directly).
# API_HOST=0.0.0.0
# API_PORT=8787

# Header names injected by Authelia via SWAG. Don't change without coordinating SWAG config.
# AUTH_HEADER_USER=Remote-User

# Per-tile provider timeouts in milliseconds.
# CLOUD_TIMEOUT_MS=300000
# LOCAL_TIMEOUT_MS=600000

# Max concurrent in-flight tiles across all users (global cap).
# Default 5 — counts CLIProxyAPI calls (one per tile), not batches.
# MAX_CONCURRENT_TILES=5
#
# Per-user cap (must be <= MAX_CONCURRENT_TILES). Default 4 matches the web
# client cap. Keeping per-user below global guarantees fairness — one user
# maxing out their batch always leaves (global - per-user) slots free.
# MAX_CONCURRENT_TILES_PER_USER=4

# Log level: error | warn | info | debug. Production runs at info.
# LOG_LEVEL=info
# Comma-separated user allowlists. Each defaults to empty (nobody).
# PROMPT_LIBRARY_USERS=alice,bob
# Local ComfyUI models; users not listed see cloud models only.
# LOCAL_MODELS_USERS=alice

# Ephemera character cards (docs/providers.md § Ephemera character cards).
# Empty EPHEMERA_BASE_URL keeps the integration off. When set, the integration
# key and the exact Ephemera origin are required.
EPHEMERA_BASE_URL=
# EPHEMERA_INTEGRATION_KEY=the-key-ephemera-holds-in-EPHEMERA_INTEGRATION_KEY
# EPHEMERA_ORIGIN=https://ephemera.example.org
# Users who see the card action. Default empty (nobody).
# EPHEMERA_USERS=alice
# Card SSE lifetime; must stay 60 s under SWAG_PROXY_READ_TIMEOUT_MS and below
# Ephemera's EPHEMERA_REQUEST_TIMEOUT_MS.
# EPHEMERA_CARD_TIMEOUT_MS=540000

# === Defense-in-depth ===

# When set, atelier-api requires every authenticated request to also carry
# `X-Atelier-Proxy-Key: <value>` matching this string. SWAG injects the
# header on the upstream proxy_pass; clients reaching the API directly
# (port leak, misconfigured network) get 401 even with a well-formed
# Remote-User header. Production MUST set this. Empty/unset disables the
# check (dev/test default).
# TRUSTED_PROXY_KEY=use-a-long-random-string

# Mock provider exposure. Defaults to enabled in dev/test (NODE_ENV !=
# production), disabled in production. Set explicitly to override either
# direction — e.g. ENABLE_MOCK_PROVIDER=false in a staging environment
# that forgot to set NODE_ENV=production.
# ENABLE_MOCK_PROVIDER=false

# Raw reply size cap for text-model streams, all providers. Default shown;
# models marked "Slow model" get at least 4 MiB.
# TEXT_MAX_RESPONSE_BYTES=1048576
