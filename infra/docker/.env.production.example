# atelier-api production env — overlay for infra/docker/docker-compose.yml.
#
# Copy this to `infra/docker/.env` on the production host only. Never commit a populated
# .env. The values below are placeholders; the real .env contains secrets.
#
# After populating, the operator MUST also:
#   1. Substitute __TRUSTED_PROXY_KEY__ in
#      infra/swag/atelier.subdomain.conf with the SAME string used here.
#   2. Run `docker compose config` to validate.
#   3. Run the spoof test from docs/deployment.md to confirm Authelia is the
#      sole gate.

# === Required ===

CLIPROXY_BASE_URL=http://127.0.0.1:8317
CLIPROXY_TOKEN=replace-with-the-real-cliproxy-bearer
# Required for GPT requests. Missing/unavailable JEV blocks GPT; local models still work.
# OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Direct ComfyUI, the only local-model host. Default unset (no local rows).
COMFYUI_BASE_URL=https://comfyui.example.internal:7860
# Required whenever the URL is configured. Missing controls fail local readiness.
COMFYUI_ATELIER_TOKEN=replace-with-the-worker-token
# Quoted PEM with escaped newlines, generated on the ComfyUI host; public trust anchor.
COMFYUI_ATELIER_CA=replace-with-worker-certificate-PEM
# Optional directory of local model manifests; must be a readable directory
# when set. Unset by default. With docker-compose.override.example.yml, the
# override sets COMFYUI_MODELS_DIR=/run/comfyui-models and binds the host
# directory named by COMFYUI_MODELS_HOST_DIR there read-only.
# COMFYUI_MODELS_DIR=/srv/atelier/models
# COMFYUI_MODELS_HOST_DIR=/srv/atelier/comfyui-models
# Comma-separated local model ids to enable. Default empty (none).
# COMFYUI_ENABLE_MODELS=
VIDEO_MODELS_ENABLED=false
# Comma-separated user allowlists. Each defaults to empty (nobody).
# PROMPT_LIBRARY_USERS=alice
# Local ComfyUI models; users not listed see cloud models only.
# LOCAL_MODELS_USERS=alice
# Ephemera character cards. Empty EPHEMERA_BASE_URL keeps the integration off.
# When set, the key is the value of Ephemera's EPHEMERA_INTEGRATION_KEY (at
# least 32 characters, never a placeholder) and the origin is Ephemera's exact
# public origin.
EPHEMERA_BASE_URL=
# EPHEMERA_INTEGRATION_KEY=replace-with-the-ephemera-integration-key
# EPHEMERA_ORIGIN=https://ephemera.example.org
# Users who see the card action. Default empty (nobody).
# EPHEMERA_USERS=alice
# Must stay 60 s under SWAG_PROXY_READ_TIMEOUT_MS and below Ephemera's
# EPHEMERA_REQUEST_TIMEOUT_MS (default 600000).
# EPHEMERA_CARD_TIMEOUT_MS=540000
# Host path of the migrated, encrypted data volume. It must contain the
# `.atelier-data-volume` marker written by api/scripts/encrypt-migrate.ts; the
# api refuses to boot without it (docs/deployment.md § Artifact encryption).
DATA_DIR=/srv/atelier
TRUSTED_PROXY_KEY=replace-with-a-long-random-string-MUST-match-SWAG-conf
BYOK_ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32
# PUBLIC age recipient (age1pq1…) of the artifact-encryption root. Not a secret:
# the matching identity stays in a host secret store and reaches the api through
# the unseal socket (docs/deployment.md § Artifact encryption).
STORAGE_ROOT_RECIPIENT=replace-with-the-age1pq1-recipient-printed-by-storage-root-init

# === Production hardening ===

# Mock provider: explicitly OFF in production. Even with NODE_ENV=production
# this defaults to false, but pinning here removes ambiguity.
ENABLE_MOCK_PROVIDER=false

# Log level — keep at info in production. Use debug only when actively
# investigating an incident.
LOG_LEVEL=info

# === Authelia headers (defaults; uncomment only if SWAG injects different names) ===

# AUTH_HEADER_USER=Remote-User

# === Per-tile timeouts (defaults; tune only if real CLIProxyAPI / ComfyUI behavior demands it) ===

# CLOUD_TIMEOUT_MS=300000
# LOCAL_TIMEOUT_MS=600000

# Global cap on concurrent tile streams across all users (one CLIProxyAPI
# call per tile). Default 5; raise only if cloud quota permits.
# MAX_CONCURRENT_TILES=5
#
# Per-user cap (must be <= MAX_CONCURRENT_TILES). Default 4 matches the web
# client cap. Keeping per-user below global guarantees a single user cannot
# fully saturate the system — others always have (global - per-user) slots.
# MAX_CONCURRENT_TILES_PER_USER=4

# === Bind addr (default 0.0.0.0 inside container is correct — SWAG is the gate) ===

# API_HOST=0.0.0.0
# API_PORT=8787

# Prompt enhancer (Kimi K3 via CLIProxyAPI). Optional limit shown.
# CLIPROXY_TEXT_MAX_RESPONSE_BYTES=1048576

# Text backends: the CLIProxyAPI (or other OpenAI-compatible proxy) model id
# each backend sends. Defaults shown; the wire shape follows the backend, not
# the id, so any id the proxy serves for that model works.
# CLIPROXY_TEXT_MODEL_KIMI=kimi-latest
# CLIPROXY_TEXT_MODEL_MIMO=mimo-v2.6-pro
# CLIPROXY_TEXT_MODEL_GROK=grok-latest
# CLIPROXY_TEXT_MODEL_GEMINI_ARGON=gemini-4-argon
# CLIPROXY_TEXT_MODEL_DEEPSEEK_ABLITERATED=abliterated-model-large-flash
# CLIPROXY_TEXT_MODEL_GLM_ABLITERATED=glm-5.3-uncensored
# CLIPROXY_TEXT_MODEL_GPT=gpt-6.1-sol

# /infer resilience layer (cliproxyText). Defaults shown; api/src/config.ts
# owns them, so leave these commented unless deliberately overriding.
# See docs/deployment.md § Resilience knobs.
# INFER_TOTAL_BUDGET_MS=500000
# RESILIENT_PER_ATTEMPT_TIMEOUT_MS=70000
# RESILIENT_MAX_ATTEMPTS=2
# RESILIENT_INITIAL_BACKOFF_MS=800
# RESILIENT_MAX_BACKOFF_MS=8000
# RESILIENT_BREAKER_THRESHOLD=8
# RESILIENT_HALF_OPEN_AFTER_MS=30000
# ENHANCE_OPEN_TIMEOUT_MS=15000
# AI_FILL_PER_ATTEMPT_TIMEOUT_MS=120000
# KREA_CONDENSE_TIMEOUT_MS=150000
# Must track proxy_read_timeout in infra/swag/atelier.subdomain.conf.
# SWAG_PROXY_READ_TIMEOUT_MS=600000
# INFER_DIMENSIONS_BATCH_CONCURRENCY=12
