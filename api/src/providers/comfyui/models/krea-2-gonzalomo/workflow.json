      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["3", 0]
    }
  },
  "9": {
    "class_type": "SaveImageWebsocket",
    "inputs": {
      "images": ["8", 0]
    }
  },
  "10": {
    "class_type": "ModelAttentionBackend",
    "inputs": {
      "model": ["1", 0],
      "attention": "comfy kitchen attention"
    }
  }
}
