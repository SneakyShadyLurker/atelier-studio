      "images": ["8", 0]
    }
  },
  "10": {
    "class_type": "ModelAttentionBackend",
    "inputs": {
      "model": ["11", 0],
      "attention": "comfy kitchen attention"
    }
  },
  "11": {
    "class_type": "SkipLayerGuidanceDiTSimple",
    "inputs": {
      "model": ["1", 0],
      "double_layers": "",
